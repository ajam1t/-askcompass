{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'No dependencies to install'",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/studio.html"
    }
  ],
  "redirects": [
    {
      "source": "/platform/ai-procedure-studio",
      "destination": "/platform/si-procedure-studio",
      "permanent": true
    },
    {
      "source": "/:file(studio|studio.html)",
      "has": [
        {
          "type": "host",
          "value": "www.askcompass.in"
        }
      ],
      "destination": "https://studio.askcompass.in/studio",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demo.askcompass.in"
        }
      ],
      "destination": "https://studio.askcompass.in/studio",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "studio.askcompass.in"
        }
      ],
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/((?!assets/|favicon|studio).+)",
      "has": [
        {
          "type": "host",
          "value": "studio.askcompass.in"
        }
      ],
      "destination": "https://www.askcompass.in/$1",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.askcompass.in"
        }
      ],
      "destination": "/workspace",
      "permanent": false
    },
    {
      "source": "/((?!workspace/unavailable|assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<tenant>[a-z0-9-]+)\\.askcompass\\.in"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "www.askcompass.in"
        },
        {
          "type": "host",
          "value": "demo.askcompass.in"
        },
        {
          "type": "host",
          "value": "studio.askcompass.in"
        },
        {
          "type": "host",
          "value": "app.askcompass.in"
        }
      ],
      "destination": "/workspace/unavailable",
      "permanent": false
    }
  ]
}
