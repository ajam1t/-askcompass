    {
      "id": "payment-retail-f4-quality",
      "name": "F4 Quality",
      "category": "Payment > Retail",
      "startStep": 38,
      "ownerRole": "QA",
      "steps": [
        {
          "step": 38,
          "question": "Was Prior Authorization obtained?",
          "type": "yesno",
          "next": {
            "yes": 39,
            "no": 107
          },
          "popup": "Check member eligibility and prior authorization requirement before proceeding.",
          "sop": "docs/payment-retail-f4-quality-sop.html",
          "pdf": "docs/PA.pdf",
          "video": "videos/PA.mp4"
        },
        {
          "step": 39,
          "question": "Select claim review outcome.",
          "type": "dropdown",
          "options": [
            {
              "label": "Approved",
              "value": "approved"
            },
            {
              "label": "Pended for research",
              "value": "pended"
            },
            {
              "label": "Denied",
              "value": "denied"
            }
          ],
          "next": {
            "approved": 40,
            "pended": 88,
            "denied": 120,
            "default": 40
          },
          "popup": "Choose the path based on policy, claim notes, and document availability.",
          "word": "docs/review-template.docx"
        },
        {
          "step": 40,
          "question": "Enter the payment amount validated during review.",
          "type": "number",
          "next": {
            "default": 41
          },
          "download": "templates/payment-quality-checklist.xlsx"
        },
        {
          "step": 41,
          "question": "Select all documents used for validation.",
          "type": "multiselect",
          "options": [
            {
              "label": "SOP",
              "value": "sop"
            },
            {
              "label": "Policy",
              "value": "policy"
            },
            {
              "label": "Claim image",
              "value": "image"
            },
            {
              "label": "Member notes",
              "value": "notes"
            }
          ],
          "next": {
            "default": 500
          },
          "externalLink": "https://example.com/policy"
        },
        {
          "step": 88,
          "question": "Add pend reason and expected follow-up date.",
          "type": "date",
          "next": {
            "default": 500
          },
          "popup": "Use a clear pend reason so the next reviewer can continue without rework."
        },
        {
          "step": 107,
          "question": "Is missing authorization eligible for exception review?",
          "type": "radio",
          "options": [
            {
              "label": "Yes, exception applies",
              "value": "exception"
            },
            {
              "label": "No exception",
              "value": "no-exception"
            }
          ],
          "next": {
            "exception": 39,
            "no-exception": 500
          },
          "image": "images/auth-exception-map.png"
        },
        {
          "step": 120,
          "question": "Document denial rationale.",
          "type": "textbox",
          "next": {
            "default": 500
          },
          "popup": "Keep the note factual and reference the policy section reviewed."
        },
        {
          "step": 500,
          "question": "Review complete. Confirm final disposition.",
          "type": "customList",
          "options": [
            {
              "label": "Complete and close",
              "value": "complete"
            },
            {
              "label": "Send to lead review",
              "value": "lead-review"
            }
          ],
          "next": {
            "complete": null,
            "lead-review": 88
          }
        }
      ]
    },
